{
  "name": "hermes-openui-stream",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --external:react-dom --define:process.env.NODE_ENV='\"production\"' --outfile=desktop/plugin.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --import ./tests/register-tsx.mjs --test tests/surface.test.tsx"
  },
  "dependencies": {
    "@openuidev/react-lang": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3"
  }
}
