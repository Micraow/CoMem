{
  "name": "comem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoMem：面向 AI agent 的上下文记忆数据库",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "build:web": "pnpm --dir web typecheck && pnpm --dir web build",
    "check:config": "tsx scripts/check-config.ts",
    "check:reachability": "tsx scripts/check-reachability.ts",
    "check:shape": "tsx scripts/check-shape.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integrations": "node --test integrations/tests/*.test.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:config && pnpm check:reachability && pnpm check:shape && pnpm check:docs && pnpm build:web && pnpm test && pnpm test:integrations",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx src/bootstrap/main.ts",
    "start": "node dist/bootstrap/main.js",
    "dev:web": "pnpm --dir web dev",
    "reindex": "tsx src/commands/reindex.ts",
    "password": "tsx src/commands/password.ts",
    "group:owner": "tsx src/commands/group-owner.ts",
    "eval": "tsx src/commands/eval.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "ingest": "tsx src/commands/ingest.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.163",
    "fastify": "^5.12.8",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.37.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
